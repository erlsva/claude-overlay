{
  "name": "obs-overlay-server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "test": "tsc && node --test dist/auth/jwt.test.js dist/auth/routes.test.js dist/socket/validation.test.js dist/seventv/emotes.test.js dist/tts/scene.test.js dist/tts/interpreter.test.js dist/tts/casting.test.js dist/tts/dsp.test.js dist/tts/discord.test.js dist/tts/service.test.js dist/twitch/eventWebhook.test.js dist/tts/audio.test.js dist/tts/sound.test.js dist/library/limits.test.js",
    "start": "node dist/index.js",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@types/tmi.js": "^1.8.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "lowdb": "^7.0.1",
    "multer": "^2.0.1",
    "pg": "^8.23.0",
    "socket.io": "^4.7.2",
    "tmi.js": "^1.8.5",
    "zod": "^3.25.76"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.11",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.23.1",
    "@types/socket.io": "^3.0.1",
    "prettier": "^3.9.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
